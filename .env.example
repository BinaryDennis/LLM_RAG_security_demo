# Fake, local-only demo values. Copy to .env. Educational use only.
POSTGRES_USER=rag
POSTGRES_PASSWORD=local-demo-password
POSTGRES_DB=rag
DATABASE_URL=postgresql+psycopg://rag:local-demo-password@127.0.0.1:5432/rag

LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# Educational demo tokens only. Replace locally; never reuse real credentials.
DEMO_TOKEN_PUBLIC=demo-public-token-change-me
DEMO_TOKEN_RESTRICTED=demo-restricted-token-change-me

LANGSMITH_TRACING=false
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
